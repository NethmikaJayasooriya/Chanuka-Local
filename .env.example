# Supabase — admin backend (orders, submissions, pricing, blog)
# Get these from the Supabase dashboard: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. NEVER expose this to the browser. Used by /admin server code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: paste the verification token from the Google Search Console
# URL-prefix property. Domain/DNS verification does not need this token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_ID=

# PayHere Checkout — server-only, never NEXT_PUBLIC_. Use the .lk domain's secret.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# Default to sandbox. Set false only when ready for approved live payments.
PAYHERE_SANDBOX=true
PAYHERE_SITE_URL=https://www.chanukajeewantha.lk
