# ===== Supabase (chanuka-jeewantha) =====
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Paste the service_role SECRET key here (Supabase > Project Settings > API keys > service_role).
# Until this line is filled, the admin panel + DB intake stay off and the site uses the email flow.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PayHere Checkout API (server-only)
PAYHERE_MERCHANT_ID=your-merchant-id
PAYHERE_MERCHANT_SECRET=your-merchant-secret
PAYHERE_SANDBOX=false
PAYHERE_SITE_URL=https://chanukajeewantha.com

# Transactional email (API key added after provider setup)...
EMAIL_FROM="Chanuka Jeewantha <orders@mail.chanukajeewantha.com>"
EMAIL_REPLY_TO=info@chanukajeewantha.com
EMAIL_ADMIN_TO=info@chanukajeewantha.com
RESEND_API_KEY=your-resend-api-key
